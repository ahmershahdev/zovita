APP_NAME=Zovita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use http://127.0.0.1:8000 with `php artisan serve`, or http://localhost/zovita under XAMPP.
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zovita
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `sync` sends mail inline. Switch to `database` and run `php artisan queue:work` in production.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ─── Email (Resend) ────────────────────────────────────────────
# Set MAIL_MAILER=resend and add your key from https://resend.com/api-keys.
# While MAIL_MAILER=log, emails are written to storage/logs/laravel.log.
MAIL_MAILER=log
RESEND_API_KEY=
RESEND_ROUTES=false
# Must be on a domain verified in Resend (resend.com/domains), or every e-mail is rejected.
MAIL_FROM_ADDRESS="orders@zovita.pk"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Store ─────────────────────────────────────────────────────
ZOVITA_SUPPORT_EMAIL=support@ahmershah.dev
ZOVITA_ADMIN_EMAIL=admin@zovita.pk
ZOVITA_SUPPORT_PHONE="+92 370 4831994"
ZOVITA_DELIVERY_FEE=150
ZOVITA_FREE_DELIVERY_OVER=2500

# ─── Google reCAPTCHA ──────────────────────────────────────────
# v3 (invisible, score based) protects login, checkout, contact, newsletter, password reset.
# v2 (checkbox) protects sign-up and prescription upload.
# The v2 keys below are Google's public test keys (always pass). Replace them in production.
RECAPTCHA_ENABLED=true
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"

# Public site URL for canonical links, sitemap, robots.txt and llms.txt
ZOVITA_SITE_URL=https://zovita.ahmershah.dev

# ─── Card payments (cash on delivery always works) ─────────────
# sandbox = built-in test gateway page (never in production), stripe = Stripe Checkout, none = COD only
PAYMENTS_DRIVER=sandbox
PAYMENTS_EXPIRES_MINUTES=30
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── Upload virus scanning (ClamAV clamd) ──────────────────────
# none locally; clamav in production (CLAMAV_SOCKET=/run/clamav/clamd.ctl or host/port)
MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_FAIL_OPEN=false

# ─── Shared abuse controls (set to redis when running several servers) ─
CACHE_LIMITER_STORE=
BAN_CACHE_STORE=

# ─── Server-side rendering (needs `npm run build` + `php artisan inertia:start-ssr`) ─
INERTIA_SSR_ENABLED=false
