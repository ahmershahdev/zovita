# Production settings for a load-balanced deployment (copy to .env on every app node).
APP_NAME=Zovita
APP_ENV=production
APP_DEBUG=false
APP_URL=https://zovita.ahmershah.dev
ZOVITA_SITE_URL=https://zovita.ahmershah.dev

# Behind nginx / a CDN: trust the forwarded IP and scheme (use your LB's CIDR instead of * if known).
TRUSTED_PROXIES=*

# Shared state lives in Redis so any app node can serve any request.
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis.internal
# Rate-limit counters and ban look-ups shared by every node (a ban applies everywhere at once).
CACHE_LIMITER_STORE=redis
BAN_CACHE_STORE=redis

# MySQL primary (writes, locks for stock/checkout) — add a read replica in config/database.php if needed.
DB_CONNECTION=mysql
DB_HOST=mysql.internal
DB_DATABASE=zovita

# Shared files: prescriptions and product images must be visible to every node
# (mount storage/app on NFS, or switch the disks to S3-compatible object storage).

MAIL_MAILER=resend
RECAPTCHA_ENABLED=true
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Card payments through Stripe Checkout (webhook: POST https://<host>/webhooks/payments/stripe,
# events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed,
# charge.refunded). The sandbox driver is refused in production.
PAYMENTS_DRIVER=stripe
PAYMENTS_EXPIRES_MINUTES=30
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Every prescription and avatar upload is streamed to clamd before it is stored.
MALWARE_SCANNER=clamav
CLAMAV_SOCKET=/run/clamav/clamd.ctl
MALWARE_SCAN_FAIL_OPEN=false

# Server-side rendering: run `php artisan inertia:start-ssr` under supervisor (see deploy/supervisor.conf).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
