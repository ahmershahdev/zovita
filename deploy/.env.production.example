# Production settings for a load-balanced deployment (copy to .env on every app node).
APP_NAME=Zovita
APP_ENV=production
APP_DEBUG=false
APP_URL=https://zovita.ahmershah.dev
ZOVITA_SITE_URL=https://zovita.ahmershah.dev

# Behind nginx / a CDN: trust the forwarded IP and scheme (use your LB's CIDR instead of * if known).
TRUSTED_PROXIES=*

# Shared state lives in Redis so any app node can serve any request.
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis.internal

# MySQL primary (writes, locks for stock/checkout) — add a read replica in config/database.php if needed.
DB_CONNECTION=mysql
DB_HOST=mysql.internal
DB_DATABASE=zovita

# Shared files: prescriptions and product images must be visible to every node
# (mount storage/app on NFS, or switch the disks to S3-compatible object storage).

MAIL_MAILER=resend
RECAPTCHA_ENABLED=true
LOG_CHANNEL=stack
LOG_LEVEL=warning
